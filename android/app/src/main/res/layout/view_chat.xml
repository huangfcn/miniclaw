<?xml version="1.0" encoding="utf-8"?>
<!-- Chat tab — port of frontend Chat.tsx / ios ChatView.swift. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tab_chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- empty state (Chat.tsx hero) -->
        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="40dp">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_avatar_empty">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="✦"
                    android:textSize="30sp"
                    android:textColor="@color/text_tertiary" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="MINICLAW ASSISTANT"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:textColor="@color/text_tertiary" />

            <TextView
                android:id="@+id/empty_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Starting up…"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <ListView
            android:id="@+id/messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="24dp"
            android:paddingBottom="16dp" />
    </FrameLayout>

    <!-- Thinking… indicator (shown while a turn is running) -->
    <LinearLayout
        android:id="@+id/thinking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:paddingHorizontal="20dp"
        android:paddingVertical="6dp">

        <ProgressBar
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:indeterminateTint="@color/text_tertiary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="THINKING…"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:textColor="@color/text_tertiary" />
    </LinearLayout>

    <!-- composer (Chat.tsx input area) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:background="@drawable/bg_composer"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:padding="8dp">

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Type a message…"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="15sp"
            android:background="@android:color/transparent"
            android:maxLines="5"
            android:minHeight="34dp"
            android:gravity="top"
            android:imeOptions="actionSend"
            android:inputType="textMultiLine|textCapSentences" />

        <TextView
            android:id="@+id/send"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="↑"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_send_btn"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
